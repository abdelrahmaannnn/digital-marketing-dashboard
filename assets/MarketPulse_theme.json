{
  "name": "MarketPulse Dark",
  "dataColors": ["#22D3EE", "#A78BFA", "#34D399", "#F59E0B", "#F472B6", "#60A5FA", "#818CF8", "#FB7185", "#2DD4BF", "#FBBF24"],
  "foreground": "#E6ECF7",
  "foregroundNeutralSecondary": "#AEB9D1",
  "foregroundNeutralTertiary": "#8592AD",
  "background": "#111A2E",
  "backgroundLight": "#1F2A44",
  "backgroundNeutral": "#1F2A44",
  "tableAccent": "#6366F1",
  "good": "#22C55E",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "maximum": "#22D3EE",
  "center": "#6366F1",
  "minimum": "#1F2A44",
  "textClasses": {
    "callout":   { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#E6ECF7" },
    "title":     { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#E6ECF7" },
    "header":    { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#C3CCE0" },
    "label":     { "fontSize": 12, "fontFace": "Segoe UI", "color": "#AEB9D1" },
    "smallLabel":{ "fontSize": 11, "fontFace": "Segoe UI", "color": "#8592AD" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": false, "transparency": 100 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": false }],
        "visualHeader": [{ "show": false }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#8592AD" } }, "showAxisTitle": false, "gridlineShow": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#8592AD" } }, "showAxisTitle": false, "gridlineColor": { "solid": { "color": "#1F2A44" } }, "gridlineStyle": "dotted" }],
        "legend": [{ "labelColor": { "solid": { "color": "#AEB9D1" } }, "position": "TopRight" }],
        "labels": [{ "color": { "solid": { "color": "#E6ECF7" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#0A1020" } } }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": false }],
        "items": [{ "fontColor": { "solid": { "color": "#E6ECF7" } }, "background": { "solid": { "color": "#0E1628" } }, "outline": "None" }],
        "data": [{ "mode": "Dropdown" }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontalColor": { "solid": { "color": "#1F2A44" } }, "rowPadding": 4 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#8592AD" } }, "backColor": { "solid": { "color": "#111A2E" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E6ECF7" } }, "backColorPrimary": { "solid": { "color": "#111A2E" } }, "fontColorSecondary": { "solid": { "color": "#E6ECF7" } }, "backColorSecondary": { "solid": { "color": "#0F172A" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 28 }],
        "categoryLabels": [{ "show": false }]
      }
    }
  }
}
